<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>VectorATC</AssemblyName>
    <RootNamespace>VectorAtc.App</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Speech" Version="8.0.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- записанные фразы голосов: voices/<язык>/<роль>/manifest.json + аудиофайлы; папка может быть пустой -->
    <Content Include="voices\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VectorAtc.Core\VectorAtc.Core.csproj" />
    <ProjectReference Include="..\VectorAtc.SimLink\VectorAtc.SimLink.csproj" />
    <ProjectReference Include="..\VectorAtc.Localization\VectorAtc.Localization.csproj" />
    <ProjectReference Include="..\VectorAtc.ViewModels\VectorAtc.ViewModels.csproj" />
  </ItemGroup>

</Project>
