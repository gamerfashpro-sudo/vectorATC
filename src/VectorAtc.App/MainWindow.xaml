<Window x:Class="VectorAtc.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="1120" Height="720" MinWidth="900" MinHeight="600"
        Background="{StaticResource WindowBg}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="310"/>
        </Grid.ColumnDefinitions>

        <!-- Боковая панель: название, позывной, язык и стиль -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,16,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,26">
                    <Border Width="40" Height="40" CornerRadius="12">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#4FD1C5" Offset="0"/>
                                <GradientStop Color="#5B8CFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="&#x2708;" FontFamily="Segoe UI Symbol" FontSize="20" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <StackPanel Margin="0,0,0,22"
                                Visibility="{Binding IsTabsVisible, Converter={StaticResource BoolToVisibility}}">
                        <Button Content="{Binding LabelTabRadio}" Command="{Binding ShowRadioCommand}"
                                HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
                        <Button Content="{Binding LabelTabTraffic}" Command="{Binding ShowTrafficCommand}"
                                HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
                        <Button Content="{Binding LabelTabMap}" Command="{Binding ShowMapCommand}"
                                HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
                        <Button Content="{Binding LabelTabDiag}" Command="{Binding ShowDiagCommand}"
                                HorizontalAlignment="Stretch" Margin="0,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding LabelCallsign}" Style="{StaticResource Caption}"/>
                    <TextBox Text="{Binding Callsign, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="Consolas" FontSize="15" Margin="0,0,0,18"/>
                    <WrapPanel>
                        <Button Content="{Binding LanguageButtonText}" Command="{Binding ToggleLanguageCommand}"
                                MinWidth="56"/>
                        <Button Content="{Binding StyleButtonText}" Command="{Binding ToggleStyleCommand}"
                                MinWidth="56"/>
                        <Button Content="{Binding VoiceButtonText}" Command="{Binding ToggleVoiceCommand}"
                                Visibility="{Binding IsVoiceVisible, Converter={StaticResource BoolToVisibility}}"/>
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Эфир: журнал, быстрые кнопки, ввод -->
        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,16,0" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <TextBlock Text="{Binding LabelLog}" FontSize="16" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <Border HorizontalAlignment="Right" Background="{StaticResource ChipBg}" CornerRadius="14"
                            Padding="12,5">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource Offline}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource Online}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{StaticResource Muted}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <ScrollViewer Grid.Row="1" x:Name="LogScroll" VerticalScrollBarVisibility="Auto" Margin="0,0,-8,0"
                              Visibility="{Binding IsLogView, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl ItemsSource="{Binding Lines}" Margin="0,0,8,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="16" Padding="14,9" Margin="0,4" MaxWidth="540">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="HorizontalAlignment" Value="Left"/>
                                            <Setter Property="Background" Value="{StaticResource ControllerBubble}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Kind}" Value="Pilot">
                                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                                    <Setter Property="Background" Value="{StaticResource PilotBubble}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="Cabin">
                                                    <Setter Property="Background" Value="{StaticResource CabinBubble}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="Violation">
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    <Setter Property="Background" Value="{StaticResource WarnBubble}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                            <TextBlock Text="{Binding Speaker}" FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Kind}" Value="Pilot">
                                                                <Setter Property="Foreground" Value="{StaticResource PilotColor}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Kind}" Value="Cabin">
                                                                <Setter Property="Foreground" Value="{StaticResource CabinColor}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Kind}" Value="Violation">
                                                                <Setter Property="Foreground" Value="{StaticResource Warn}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Time}" FontSize="11" FontFamily="Consolas"
                                                       Foreground="{StaticResource Muted}" Margin="8,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <ItemsControl Grid.Row="2" ItemsSource="{Binding QuickActions}" Margin="0,12,0,4"
                              Visibility="{Binding IsLogView, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Label}" Command="{Binding Command}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Grid.Row="3" Visibility="{Binding IsLogView, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="TalkButton" Grid.Column="0" Content="{Binding TalkButtonText}"
                            Margin="0,0,10,0" Padding="18,11"
                            Visibility="{Binding IsTalkVisible, Converter={StaticResource BoolToVisibility}}"/>
                    <Grid Grid.Column="1">
                        <TextBox Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding SendCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Text="{Binding InputHint}" IsHitTestVisible="False"
                                   Foreground="{StaticResource Muted}" Margin="17,0,0,0" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding InputText}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Button Grid.Column="2" Style="{StaticResource PrimaryButton}"
                            Content="{Binding LabelSend}" Command="{Binding SendCommand}"
                            Margin="10,0,0,0" Padding="24,11"/>
                </Grid>

                <!-- Диагностика: занимает место журнала, быстрых кнопок и ввода -->
                <Grid Grid.Row="1" Grid.RowSpan="3"
                      Visibility="{Binding IsDiagView, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="{Binding LabelDiagTitle}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                        <Button x:Name="CopyReportButton" Content="{Binding LabelDiagCopy}" HorizontalAlignment="Right"
                                Padding="14,6"/>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding DiagnosticsItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="210"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Width="9" Height="9" Margin="0,5,10,0" VerticalAlignment="Top">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{StaticResource Muted}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Level}" Value="Ok">
                                                            <Setter Property="Fill" Value="{StaticResource Online}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Level}" Value="Warn">
                                                            <Setter Property="Fill" Value="{StaticResource Warn}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Level}" Value="Fail">
                                                            <Setter Property="Fill" Value="{StaticResource Offline}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Grid.Column="1" Text="{Binding Label}" Foreground="{StaticResource Muted}"
                                                   FontSize="12" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Value}" FontFamily="Consolas" FontSize="12"
                                                   TextWrapping="Wrap"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- Карта: занимает место журнала, быстрых кнопок и ввода -->
                <Border x:Name="MapHost" Grid.Row="1" Grid.RowSpan="3" CornerRadius="16" Background="#0B1020"
                        BorderBrush="{StaticResource CardBorder}" BorderThickness="1" ClipToBounds="True"
                        Visibility="{Binding IsMapView, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <ItemsControl ItemsSource="{Binding MapRings}" IsHitTestVisible="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                    <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="{Binding Diameter}" Height="{Binding Diameter}">
                                        <Ellipse Stroke="#26FFFFFF" StrokeThickness="1" StrokeDashArray="3 4"/>
                                        <TextBlock Text="{Binding Label}" FontSize="10" Foreground="{StaticResource Muted}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding MapMarkers}" IsHitTestVisible="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Path Data="M 0,-9 L 6,7 L 0,3 L -6,7 Z" Stroke="#99000000" StrokeThickness="0.5">
                                            <Path.RenderTransform>
                                                <RotateTransform Angle="{Binding HeadingDeg}"/>
                                            </Path.RenderTransform>
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Fill" Value="{StaticResource PilotColor}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Kind}" Value="Own">
                                                            <Setter Property="Fill" Value="{StaticResource Accent}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="Ground">
                                                            <Setter Property="Fill" Value="{StaticResource Muted}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                        <StackPanel Margin="12,-12,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="{StaticResource Muted}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="N" Foreground="{StaticResource Muted}" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0">
                            <TextBlock Text="{Binding MapRangeText}" Foreground="{StaticResource Muted}" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Button Content="+" Command="{Binding ZoomInCommand}" Padding="12,3" Margin="0,0,6,0"/>
                            <Button Content="&#x2212;" Command="{Binding ZoomOutCommand}" Padding="12,3" Margin="0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Таблица трафика: занимает место журнала, быстрых кнопок и ввода -->
                <Grid Grid.Row="1" Grid.RowSpan="3"
                      Visibility="{Binding IsTrafficView, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{Binding LabelTrafficNote}" Foreground="{StaticResource Warn}"
                               FontSize="12" Margin="0,0,0,10" TextWrapping="Wrap"/>
                    <Grid Grid.Row="1" Margin="12,0,12,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="0.7*"/>
                            <ColumnDefinition Width="0.8*"/>
                            <ColumnDefinition Width="1.6*"/>
                            <ColumnDefinition Width="1.1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding LabelColCallsign}" Style="{StaticResource Caption}"/>
                        <TextBlock Grid.Column="1" Text="{Binding LabelColAirline}" Style="{StaticResource Caption}"/>
                        <TextBlock Grid.Column="2" Text="{Binding LabelColType}" Style="{StaticResource Caption}"/>
                        <TextBlock Grid.Column="3" Text="{Binding LabelColRoute}" Style="{StaticResource Caption}"/>
                        <TextBlock Grid.Column="4" Text="{Binding LabelColAltitude}" Style="{StaticResource Caption}"/>
                        <TextBlock Grid.Column="5" Text="{Binding LabelColSpeed}" Style="{StaticResource Caption}"/>
                        <TextBlock Grid.Column="6" Text="{Binding LabelColDistance}" Style="{StaticResource Caption}"/>
                    </Grid>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding TrafficRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource ControllerBubble}" CornerRadius="12"
                                            Padding="12,9" Margin="0,3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.3*"/>
                                                <ColumnDefinition Width="0.7*"/>
                                                <ColumnDefinition Width="0.8*"/>
                                                <ColumnDefinition Width="1.6*"/>
                                                <ColumnDefinition Width="1.1*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="1*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Callsign}" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Accent}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Airline}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Aircraft}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Route}" FontFamily="Consolas"/>
                                            <TextBlock Grid.Column="4" Text="{Binding Altitude}" FontFamily="Consolas"/>
                                            <TextBlock Grid.Column="5" Text="{Binding Speed}" FontFamily="Consolas"/>
                                            <TextBlock Grid.Column="6" Text="{Binding Distance}" FontFamily="Consolas"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>

        <!-- Справа: симулятор, диспетчер, самолёт -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Margin="0,0,-8,0">
        <StackPanel Margin="0,0,8,0">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{Binding LabelStatus}" Style="{StaticResource Caption}"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="15" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <WrapPanel>
                        <Button Style="{StaticResource PrimaryButton}" Content="{Binding ConnectButtonText}"
                                Command="{Binding ConnectCommand}"/>
                        <Button Content="{Binding SourceButtonText}" Command="{Binding ToggleSourceCommand}"/>
                        <Button Content="{Binding LabelNextFrame}" Command="{Binding NextFrameCommand}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{Binding LabelPhase}" Style="{StaticResource Caption}"/>
                    <TextBlock Text="{Binding PhaseText}" FontSize="26" FontWeight="SemiBold"
                               Foreground="{StaticResource Accent}" Margin="0,0,0,14"/>
                    <TextBlock Text="{Binding LabelState}" Style="{StaticResource Caption}"/>
                    <TextBlock Text="{Binding StateText}" FontSize="15" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{Binding LabelTelemetry}" Style="{StaticResource Caption}"/>
                    <TextBlock Text="{Binding TelemetryText}" FontFamily="Consolas" FontSize="12"
                               TextWrapping="Wrap" LineHeight="20"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}"
                    Visibility="{Binding IsGroundVisible, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{Binding LabelGround}" Style="{StaticResource Caption}"/>
                    <ItemsControl ItemsSource="{Binding GroundServices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,6,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <Grid>
                                            <TextBlock Text="{Binding Name}" FontSize="13"/>
                                            <TextBlock Text="{Binding StateText}" FontSize="12" HorizontalAlignment="Right"
                                                       Foreground="{StaticResource Muted}"/>
                                        </Grid>
                                        <ProgressBar Value="{Binding ProgressPercent}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="{Binding DataContext.LabelOrder, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            Command="{Binding RequestCommand}" Margin="12,0,0,0" Padding="12,5"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
