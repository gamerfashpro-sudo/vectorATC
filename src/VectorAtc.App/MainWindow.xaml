<Window x:Class="VectorAtc.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="1000" Height="640" MinWidth="760" MinHeight="480"
        Background="{StaticResource WindowBg}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="290"/>
        </Grid.ColumnDefinitions>

        <!-- Журнал, быстрые кнопки и строка ввода -->
        <Grid Grid.Column="0" Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{Binding LabelLog}" Style="{StaticResource Caption}"/>

            <Border Grid.Row="1" Style="{StaticResource Card}">
                <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Lines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Time}" FontFamily="Consolas"
                                               Foreground="{StaticResource Muted}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Speaker}" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Kind}" Value="Pilot">
                                                        <Setter Property="Foreground" Value="{StaticResource PilotColor}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="Violation">
                                                        <Setter Property="Foreground" Value="{StaticResource Warn}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Column="2" Text="{Binding Text}" TextWrapping="Wrap"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <ItemsControl Grid.Row="2" ItemsSource="{Binding QuickActions}" Margin="0,0,0,4">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Label}" Command="{Binding Command}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <TextBox Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding SendCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock Text="{Binding InputHint}" IsHitTestVisible="False"
                               Foreground="{StaticResource Muted}" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding InputText}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <Button Grid.Column="1" Content="{Binding LabelSend}" Command="{Binding SendCommand}"
                        Margin="8,0,0,0" Padding="18,9"/>
            </Grid>
        </Grid>

        <!-- Состояние и управление -->
        <StackPanel Grid.Column="1">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{Binding LabelStatus}" Style="{StaticResource Caption}"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="15" Margin="0,0,0,10"/>
                    <WrapPanel>
                        <Button Content="{Binding ConnectButtonText}" Command="{Binding ConnectCommand}"/>
                        <Button Content="{Binding LabelNextFrame}" Command="{Binding NextFrameCommand}"/>
                        <Button Content="{Binding SourceButtonText}" Command="{Binding ToggleSourceCommand}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{Binding LabelPhase}" Style="{StaticResource Caption}"/>
                    <TextBlock Text="{Binding PhaseText}" FontSize="20" FontWeight="SemiBold"
                               Foreground="{StaticResource Accent}" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding LabelState}" Style="{StaticResource Caption}"/>
                    <TextBlock Text="{Binding StateText}" FontSize="15" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{Binding LabelTelemetry}" Style="{StaticResource Caption}"/>
                    <TextBlock Text="{Binding TelemetryText}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{Binding LabelCallsign}" Style="{StaticResource Caption}"/>
                    <TextBox Text="{Binding Callsign, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                    <WrapPanel>
                        <Button Content="{Binding LanguageButtonText}" Command="{Binding ToggleLanguageCommand}"
                                MinWidth="52"/>
                        <Button Content="{Binding StyleButtonText}" Command="{Binding ToggleStyleCommand}"
                                MinWidth="52"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
